#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Redox handwire - starting keymap.
 *
 * The goal of THIS layer is only that every physical key registers something
 * when you test. The legend-to-physical-key mapping almost certainly won't be
 * perfect on the first flash (that's normal for a handwire). Press each key,
 * see what appears, then rearrange the bindings below so each key sits where
 * you want it.
 *
 * Each row below is 14 keys: 7 left, then 7 right.
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6      &kp N7  &kp N8    &kp N9   &kp N0    &kp MINUS &kp EQUAL &kp BSPC
&kp TAB   &kp Q   &kp W   &kp E   &kp R   &kp T      &kp Y       &kp U   &kp I     &kp O    &kp P     &kp LBKT  &kp RBKT  &kp BSLH
&kp LCTRL &kp A   &kp S   &kp D   &kp F   &kp G      &kp H       &kp J   &kp K     &kp L    &kp SEMI  &kp SQT   &kp GRAVE &kp RET
&kp LSHFT &kp Z   &kp X   &kp C   &kp V   &kp B      &kp N       &kp M   &kp COMMA &kp DOT  &kp FSLH  &kp UP    &kp RSHFT &kp DEL
&kp LGUI  &kp LALT &kp SPACE &kp BSPC &kp TAB &kp ESC  &kp RCTRL  &kp RET &kp SPACE &kp HOME &kp LEFT &kp DOWN  &kp UP    &kp RIGHT
            >;
        };
    };
};
