#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Redox handwire - starting keymap.
 *
 * The goal of THIS layer is only that every physical key registers something
 * when you test. The legend-to-physical-key mapping almost certainly won't be
 * perfect on the first flash (that's normal for a handwire). Press each key,
 * see what appears, then rearrange the bindings below so each key sits where
 * you want it.
 *
 * Each row below is 14 keys: 7 left, then 7 right.
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1    &kp N2       &kp N3    &kp N4     &kp N5     &kp N6    /*Split*/  &kp N7    &kp N8     &kp N9     &kp N0     &kp MINUS  &kp EQUAL  &kp LBKT
&kp TAB    &kp Q     &kp W        &kp E     &kp R      &kp T      &kp RET   /*Split*/  &kp RET   &kp Y      &kp U      &kp I      &kp O      &kp P      &kp RBKT
&kp CAPS   &kp A     &kp S        &kp D     &kp F      &kp G      &mo 1     /*Split*/  &kp RALT  &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT  &kp Z     &kp X        &kp C     &kp V      &kp B      &kp LALT  /*Split*/  &kp LALT  &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&kp LCTRL  &kp LALT  &lt 1 GRAVE  &kp BSPC  &kp SPACE  &kp LCTRL  &kp LGUI  /*Split*/  &kp LGUI  &kp RCTRL  &kp SPACE  &kp BSPC   &kp HOME   &kp END    &mo 1
            >;
        };

        /*
         * Fn-style layer: hold left row2/col6 or right row4/col6 (&mo 1),
         * or hold the left thumb key (&lt 1 GRAVE, tap = grave/backtick).
         * Bluetooth profile switching lives here (BT_SEL 0/1, BT_CLR) -
         * there is no &studio_unlock binding on this layer since Studio is
         * unlocked via the dedicated physical button on pro_micro pin 0
         * instead (see redox_handwire_left.overlay).
         */
        studio_layer {
            display-name = "Level 2";
            bindings = <
&kp GRAVE  &kp F1    &kp F2    &kp F3     &kp F4  &kp F5        &kp F6      /*Split*/  &kp F7    &kp F8         &kp F9     &kp F10    &kp F11           &kp F12           &kp C_EJECT
&trans     &trans    &kp UP    &trans     &trans  &bt BT_SEL 0  &bt BT_CLR  /*Split*/  &trans    &trans         &trans     &trans     &trans            &kp C_PLAY_PAUSE  &kp C_VOL_UP
&trans     &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &bt BT_SEL 1  &trans      /*Split*/  &trans    &kp C_AC_BACK  &kp PG_DN  &kp PG_UP  &kp C_AC_FORWARD  &trans            &kp C_VOL_DN
&trans     &trans    &trans    &trans     &trans  &trans        &trans      /*Split*/  &trans    &trans         &trans     &trans     &trans            &trans            &kp RSHFT
&trans     &trans    &trans    &kp DEL    &trans  &trans        &trans      /*Split*/  &kp LGUI  &trans         &trans     &kp DEL    &trans            &trans            &trans
            >;
        };
    };
};
