#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Redox handwire - starting keymap.
 *
 * The goal of THIS layer is only that every physical key registers something
 * when you test. The legend-to-physical-key mapping almost certainly won't be
 * perfect on the first flash (that's normal for a handwire). Press each key,
 * see what appears, then rearrange the bindings below so each key sits where
 * you want it.
 *
 * Each row below is 14 keys: 7 left, then 7 right.
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1    &kp N2     &kp N3    &kp N4     &kp N5     &kp N6     /*Split*/  &kp N7    &kp N8     &kp N9     &kp N0     &kp MINUS  &kp EQUAL  &kp LBKT
&kp TAB    &kp Q     &kp W      &kp E     &kp R      &kp T      &kp RET    /*Split*/  &kp BSPC  &kp Y      &kp U      &kp I      &kp O      &kp P      &kp RBKT  /*&kp BSLH*/
&kp CAPS   &kp A     &kp S      &kp D     &kp F      &kp G      &kp GRAVE  /*Split*/  &kp RALT  &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT  &kp Z     &kp X      &kp C     &kp V      &kp B      &kp LALT   /*Split*/  &kp LALT  &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&kp LCTRL  &kp LALT  &kp SPACE  &kp BSPC  &kp SPACE  &kp LCTRL  &kp LGUI   /*Split*/  &kp LGUI  &kp RCTRL  &kp SPACE  &kp RCTRL  &kp HOME   &kp END    &kp UP
            >;
        };
    };
};
